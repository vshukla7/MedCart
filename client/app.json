{
  "expo": {
    "name": "MedCart",
    "slug": "medcart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medcart.pharmacy"
    },
    "android": {
      "package": "com.medcart.pharmacy",
      "newArchEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.jpeg",
          "color": "#ffffff",
          "defaultChannel": "medcart-reminders"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "1331205f-2880-4fc8-bba5-3f8567ace8fb"
      }
    },
    "owner": "algotec"
  }
}
